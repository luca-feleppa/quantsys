# IT: unit systemd — forward test vol-paper 04b (MIGRATO dal PC di casa il
#     2026-07-18: elimina il bias di selezione oraria del campione — entry solo
#     a PC acceso, 18.6% coverage pre-14/07). Tick orario, ordini REALI sul
#     testnet Deribit (--execute; assert anti-mainnet nel codice). Prerequisiti
#     NON in git: config/secrets.yaml (blocco deribit_testnet, chmod 600),
#     models/itransformer/ (ensemble vol PASS), data/raw_candles.parquet,
#     data/macro_features.parquet (push da casa via pull_vps_data.ps1),
#     results/vol_paper/ (seed di continuità del forward test).
#     Install: cp in /etc/systemd/system/ → daemon-reload → enable --now
#     (insieme a quantsys-volpaper-restart.timer).
# EN: systemd unit — 04b vol-paper forward test (MIGRATED from the home PC on
#     2026-07-18: removes the sample's hour-selection bias — entries only while
#     the PC was on, 18.6% coverage pre-07/14). Hourly tick, REAL Deribit
#     testnet orders (--execute; anti-mainnet assert in code). Prerequisites
#     NOT in git: config/secrets.yaml (deribit_testnet block, chmod 600),
#     models/itransformer/ (PASS vol ensemble), data/raw_candles.parquet,
#     data/macro_features.parquet (pushed from home by pull_vps_data.ps1),
#     results/vol_paper/ (forward-test continuity seed).
#     Install: cp into /etc/systemd/system/ → daemon-reload → enable --now
#     (together with quantsys-volpaper-restart.timer).
[Unit]
Description=QUANTSYS 04b vol-paper forward test (NN-RV vs IV, Deribit testnet)
After=network-online.target quantsys-iv.service
Wants=network-online.target

[Service]
Type=simple
User=quantsys
WorkingDirectory=/opt/quantsys
# IT: STATO TRANSITORIO DI WIND-DOWN (2026-08-12) — il gate hedged-vs-unhedged
#     si e' chiuso l'11/08 con FAIL 2/3 (varianza -55.3%, ma drag -0.647 SE
#     contro un budget di -0.25 SE, per il 76% fee perp): --hedge e' FALLITO e
#     la v1 unhedged e' il design di produzione. Il flag NON viene rimosso in un
#     colpo per un vincolo di ORDINE: maybe_hedge e reconcile_hedge_state girano
#     SOLO dentro --hedge, quindi riavviare senza il flag con una leg perp
#     aperta la lascerebbe NUDA e mai flattenata sul testnet. La banda 999
#     rende impossibile aprire o ribilanciare un hedge (il check di banda esce
#     prima di qualunque ordine) MA lascia attivo il flatten a settlement /
#     expiry / cambio struttura, che gira PRIMA del check di banda: la leg
#     residua viene chiusa dal codice che ha scritto tutte le altre, cosi'
#     hedge_ledger.jsonl resta internamente consistente.
#     ⚠ Non e' un cambio di parametro a giudizio in corso: il congelamento
#     band=0.30/conv=raw valeva per la durata del gate, ora chiuso, e il
#     campione giudicato (n=20, ultimo settlement exp 11AUG) e' frozen in
#     results/vols/hedged_vs_unhedged.json — la posizione hedgiata ancora
#     aperta e' la 22esima e sta fuori dal campione per costruzione.
#     ⚠ DA RIMUOVERE dopo il settlement del 13AUG 08:00 UTC, verificato il
#     flatten nel ledger: ExecStart torna al solo --execute (v1).
# EN: TRANSIENT WIND-DOWN STATE (2026-08-12) — the hedged-vs-unhedged gate
#     closed on 08/11 with FAIL 2/3 (variance -55.3%, but drag -0.647 SE against
#     a -0.25 SE budget, 76% of it perp fees): --hedge FAILED and unhedged v1 is
#     the production design. The flag is NOT removed in one step because of an
#     ORDER constraint: maybe_hedge and reconcile_hedge_state run ONLY under
#     --hedge, so restarting without it while a perp leg is open would leave it
#     NAKED and never flattened on the testnet. A 999 band makes opening or
#     rebalancing a hedge impossible (the band check returns before any order)
#     but keeps the settlement / expiry / structure-change flatten active, since
#     that runs BEFORE the band check: the residual leg is closed by the same
#     code that wrote all the others, so hedge_ledger.jsonl stays internally
#     consistent.
#     ⚠ This is not a mid-judgment parameter change: the band=0.30/conv=raw
#     freeze held for the gate's duration, now closed, and the judged sample
#     (n=20, last settlement exp 11AUG) is frozen in
#     results/vols/hedged_vs_unhedged.json — the still-open hedged position is
#     the 22nd and lies outside the sample by construction.
#     ⚠ TO BE REMOVED after the 13AUG 08:00 UTC settlement, once the flatten is
#     verified in the ledger: ExecStart goes back to --execute alone.
ExecStart=/opt/quantsys/.venv/bin/python scripts/04b_vol_paper.py --execute --hedge --hedge-band 999 --hedge-conv raw
Environment=PYTHONUNBUFFERED=1
Restart=always
RestartSec=60
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
