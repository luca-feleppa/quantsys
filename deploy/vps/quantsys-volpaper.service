# IT: unit systemd — forward test vol-paper 04b (MIGRATO dal PC di casa il
#     2026-07-18: elimina il bias di selezione oraria del campione — entry solo
#     a PC acceso, 18.6% coverage pre-14/07). Tick orario, ordini REALI sul
#     testnet Deribit (--execute; assert anti-mainnet nel codice). Prerequisiti
#     NON in git: config/secrets.yaml (blocco deribit_testnet, chmod 600),
#     models/itransformer/ (ensemble vol PASS), data/raw_candles.parquet,
#     data/macro_features.parquet (push da casa via pull_vps_data.ps1),
#     results/vol_paper/ (seed di continuità del forward test).
#     Install: cp in /etc/systemd/system/ → daemon-reload → enable --now
#     (insieme a quantsys-volpaper-restart.timer).
# EN: systemd unit — 04b vol-paper forward test (MIGRATED from the home PC on
#     2026-07-18: removes the sample's hour-selection bias — entries only while
#     the PC was on, 18.6% coverage pre-07/14). Hourly tick, REAL Deribit
#     testnet orders (--execute; anti-mainnet assert in code). Prerequisites
#     NOT in git: config/secrets.yaml (deribit_testnet block, chmod 600),
#     models/itransformer/ (PASS vol ensemble), data/raw_candles.parquet,
#     data/macro_features.parquet (pushed from home by pull_vps_data.ps1),
#     results/vol_paper/ (forward-test continuity seed).
#     Install: cp into /etc/systemd/system/ → daemon-reload → enable --now
#     (together with quantsys-volpaper-restart.timer).
[Unit]
Description=QUANTSYS 04b vol-paper forward test (NN-RV vs IV, Deribit testnet)
After=network-online.target quantsys-iv.service
Wants=network-online.target

[Service]
Type=simple
User=quantsys
WorkingDirectory=/opt/quantsys
# IT: SHORT-VOL v1 UNHEDGED = design di produzione (dal 2026-08-13). Il gate
#     pre-registrato hedged-vs-unhedged si e' chiuso l'11/08 con FAIL 2/3: la
#     varianza del PnL scende del 55.3% (condizione ① PASS con margine) ma il
#     drag e' -0.647 SE contro un budget pre-dichiarato di -0.25 SE, e il 76%
#     di quel drag sono fee taker sul perp (funding: 0.9%, l'incognita
#     dichiarata era la componente sbagliata). La delta-hedge muore sul COSTO
#     DI REALIZZAZIONE a size 1 contratto, non sulla teoria. Record macchina:
#     results/vols/hedged_vs_unhedged.json (n=20, ultimo settlement exp 11AUG).
#     ⚠ Se un giorno si volesse riattivare --hedge, il vincolo di ORDINE vale
#     in entrambe le direzioni: maybe_hedge e reconcile_hedge_state girano SOLO
#     dentro il flag, quindi spegnerlo con una leg perp aperta la lascerebbe
#     NUDA e mai flattenata. La disattivazione qui e' avvenuta in due passi
#     (banda di wind-down 999 il 12/08, che blocca apertura e ribilanciamento
#     ma lascia attivo il flatten perche' quel ramo gira PRIMA del check di
#     banda; rimozione dei tre flag il 13/08 a leg verificata piatta).
# EN: SHORT-VOL v1 UNHEDGED = production design (since 2026-08-13). The
#     pre-registered hedged-vs-unhedged gate closed on 08/11 with FAIL 2/3: PnL
#     variance drops 55.3% (condition ① PASS with margin) but the drag is
#     -0.647 SE against a pre-declared -0.25 SE budget, and 76% of that drag is
#     perp taker fees (funding: 0.9% — the declared unknown was the wrong
#     component). Delta hedging dies on the COST OF REALIZATION at 1-contract
#     size, not on the theory. Machine record:
#     results/vols/hedged_vs_unhedged.json (n=20, last settlement exp 11AUG).
#     ⚠ Should --hedge ever be re-enabled, the ORDER constraint cuts both ways:
#     maybe_hedge and reconcile_hedge_state run ONLY under the flag, so turning
#     it off with an open perp leg would leave that leg NAKED and never
#     flattened. Deactivation here took two steps (999 wind-down band on 08/12,
#     which blocks opening and rebalancing but keeps the flatten alive because
#     that branch runs BEFORE the band check; removal of the three flags on
#     08/13 once the leg was verified flat).
ExecStart=/opt/quantsys/.venv/bin/python scripts/04b_vol_paper.py --execute
Environment=PYTHONUNBUFFERED=1
Restart=always
RestartSec=60
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
