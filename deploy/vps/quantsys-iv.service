# IT: unit systemd — poller IV Deribit (01c), tick ogni 5 min + greeks ATM
#     (C4 2026-07-18: cadenza 10→5 min, --greeks attivo — serie atm_greeks
#     per la replayabilità offline della leg hedge v2).
#     Install: cp in /etc/systemd/system/ → daemon-reload → enable --now.
# EN: systemd unit — Deribit IV poller (01c), 5-min tick + ATM greeks
#     (C4 2026-07-18: cadence 10→5 min, --greeks on — atm_greeks series for
#     offline replayability of the v2 hedge leg).
#     Install: cp into /etc/systemd/system/ → daemon-reload → enable --now.
[Unit]
Description=QUANTSYS 01c Deribit IV poller (atm_30h + chain + dvol + greeks)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=quantsys
WorkingDirectory=/opt/quantsys
ExecStart=/opt/quantsys/.venv/bin/python scripts/01c_iv_poller.py --minutes 5 --greeks
# IT: log non bufferizzati su journald (journalctl -u quantsys-iv -f).
# EN: unbuffered logs to journald (journalctl -u quantsys-iv -f).
Environment=PYTHONUNBUFFERED=1
Restart=always
RestartSec=30
# IT: hardening minimo — nessun privilegio nuovo, /tmp privato.
# EN: minimal hardening — no new privileges, private /tmp.
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
