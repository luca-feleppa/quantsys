# ── Python build artifacts ────────────────────────────────────
__pycache__/
*.py[cod]
*.pyo
*.pyd
*.so
*.egg
*.egg-info/
dist/
build/
.eggs/

# ── Virtual environment ───────────────────────────────────────
.venv/
venv/
ENV/
env/

# ── Dati (file grandi, generati automaticamente) ─────────────
data/*
!data/.gitkeep

# ── Modelli (pesi PyTorch, possono essere centinaia di MB) ───
models/*
!models/.gitkeep

# ── Risultati backtest/live (generati dalla pipeline) ────────
results/*
!results/.gitkeep

# ── Log rotativi ─────────────────────────────────────────────
logs/*
!logs/.gitkeep

# ── Esperimenti (snapshot di training — possono essere GB) ───
experiments/

# ── Secrets e config locali ───────────────────────────────────
# Metti qui chiavi API o config personali che non devono finire su GitHub
config/secrets.yaml
.env
.env.*

# ── OS e IDE ─────────────────────────────────────────────────
.DS_Store
Thumbs.db
desktop.ini
.idea/
.vscode/
*.swp
*.swo
*~

# ── Jupyter ───────────────────────────────────────────────────
.ipynb_checkpoints/
*.ipynb

# ── Coverage e test temporanei ───────────────────────────────
.coverage
htmlcov/
.pytest_cache/
.mypy_cache/

# ── Local Claude Code metadata (auto-memory, transcripts) ────
.claude/

# ── Log a root (i log normali stanno in logs/) ───────────────
*.log

# ── Node / Vite (dashboard frontend) ─────────────────────────
node_modules/
dashboard/dist/
dashboard/build/
dashboard/.vite/
.npm/
.yarn/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
