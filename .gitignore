# ── Python build artifacts ────────────────────────────────────
__pycache__/
*.py[cod]
*.pyo
*.pyd
*.so
*.egg
*.egg-info/
dist/
build/
.eggs/

# ── Virtual environment ───────────────────────────────────────
.venv/
venv/
ENV/
env/

# ── Dati (file grandi, generati automaticamente) ─────────────
data/*
!data/.gitkeep

# ── Modelli (pesi PyTorch, possono essere centinaia di MB) ───
models/*
!models/.gitkeep

# ── Sandbox modelli isolata (QUANTSYS_MODELS_ROOT, es. distill/k-fold) ───
models_distill_vol/
models_*_sandbox/
# IT: sandbox Fase B post-gate-v1 (pre-reg B2/B3/B4) | EN: post-gate-v1 Phase B sandboxes
models_a3_moe/
models_a8_mixup/
models_dvol_probe/

# ── Risultati backtest/live (generati dalla pipeline) ────────
results/*
!results/.gitkeep

# ── Log rotativi ─────────────────────────────────────────────
logs/*
!logs/.gitkeep

# ── Esperimenti (snapshot di training — possono essere GB) ───
experiments/

# ── Secrets e config locali ───────────────────────────────────
# Metti qui chiavi API o config personali che non devono finire su GitHub
config/secrets.yaml
.env
.env.*
!.env.example

# ── OS e IDE ─────────────────────────────────────────────────
.DS_Store
Thumbs.db
desktop.ini
.idea/
.vscode/
*.swp
*.swo
*~

# ── Jupyter ───────────────────────────────────────────────────
.ipynb_checkpoints/
*.ipynb

# ── Coverage e test temporanei ───────────────────────────────
.coverage
htmlcov/
.pytest_cache/
.mypy_cache/

# ── Claude Code: config di progetto VERSIONATA (settings.json, hooks/, agents/,
#    skills/), metadata locale IGNORATO / project config VERSIONED, local metadata IGNORED
.claude/settings.local.json
.claude/plans/
.claude/tasks/

# ── Log a root (i log normali stanno in logs/) ───────────────
*.log

# ── Node / Vite (dashboard frontend) ─────────────────────────
node_modules/
dashboard/dist/
dashboard/build/
dashboard/.vite/
.npm/
.yarn/
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# IT: file temporaneo messaggi di commit / EN: temp commit-message file
.commit_msg.tmp
