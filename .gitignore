# ── Python build artifacts ────────────────────────────────────
__pycache__/
*.py[cod]
*.pyo
*.pyd
*.so
*.egg
*.egg-info/
dist/
build/
.eggs/

# ── Virtual environment ───────────────────────────────────────
.venv/
venv/
ENV/
env/

# ── Dati (file grandi, generati automaticamente) ─────────────
data/*
!data/.gitkeep

# ── Modelli (pesi PyTorch, possono essere centinaia di MB) ───
models/*
!models/.gitkeep

# ── Sandbox modelli isolata (QUANTSYS_MODELS_ROOT, es. distill/k-fold) ───
models_distill_vol/
models_*_sandbox/
# IT: sandbox Fase B post-gate-v1 (pre-reg B2/B3/B4) | EN: post-gate-v1 Phase B sandboxes
models_a3_moe/
models_a8_mixup/
models_dvol_probe/

# ── Risultati backtest/live (generati dalla pipeline) ────────
results/*
!results/.gitkeep

# IT: ECCEZIONE — i report macchina dei verdetti vol sono la FONTE citata dai
#     doc ("il record e' il JSON, non la prosa"): vanno versionati, altrimenti
#     un claim pubblico poggia su un file che esiste su un solo disco. Sono
#     piccoli (~250 KB in tutto) e immutabili una volta chiuso il loro gate.
#     Regole di negazione invece di `git add -f` caso per caso: l'incoerenza
#     precedente (2 file su 41 tracciati) nasceva proprio dal force-add a mano.
# EN: EXCEPTION — the vol verdicts' machine reports are the source cited by the
#     docs ("the record is the JSON, not the prose"): they must be versioned, or
#     a public claim rests on a file living on a single disk. They are small
#     (~250 KB total) and immutable once their gate closes. Negation rules
#     instead of case-by-case `git add -f`: the previous inconsistency (2 of 41
#     files tracked) came precisely from manual force-adds.
!results/vols/
results/vols/*
!results/vols/*.json

# IT: da vol_paper SOLO i record statici di gate chiusi. I sei file live
#     (forecasts/trades/exec_diag/hedge_ledger/hedge_state/position) cambiano a
#     ogni tick orario: in git sarebbero churn puro e metterebbero lo stato del
#     forward test sotto versione. Restano mirror VPS + copia locale.
# EN: from vol_paper ONLY the static records of closed gates. The six live files
#     (forecasts/trades/exec_diag/hedge_ledger/hedge_state/position) change at
#     every hourly tick: in git they would be pure churn and would put forward-test
#     state under version control. They stay as VPS mirror + local copy.
!results/vol_paper/
results/vol_paper/*
!results/vol_paper/baseline_report.json
!results/vol_paper/edge_information_stage1.json
!results/vol_paper/pin_close_feasibility.json

# ── Log rotativi ─────────────────────────────────────────────
logs/*
!logs/.gitkeep

# ── Esperimenti (snapshot di training — possono essere GB) ───
experiments/

# ── Secrets e config locali ───────────────────────────────────
# Metti qui chiavi API o config personali che non devono finire su GitHub
config/secrets.yaml
.env
.env.*
!.env.example

# ── OS e IDE ─────────────────────────────────────────────────
.DS_Store
Thumbs.db
desktop.ini
.idea/
.vscode/
*.swp
*.swo
*~

# ── Jupyter ───────────────────────────────────────────────────
.ipynb_checkpoints/
*.ipynb

# ── Coverage e test temporanei ───────────────────────────────
.coverage
htmlcov/
.pytest_cache/
.mypy_cache/

# ── Log a root (i log normali stanno in logs/) ───────────────
*.log

# ── Node / Vite (dashboard frontend) ─────────────────────────
node_modules/
dashboard/dist/
dashboard/build/
dashboard/.vite/
.npm/
.yarn/
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# IT: file temporaneo messaggi di commit / EN: temp commit-message file
.commit_msg.tmp
