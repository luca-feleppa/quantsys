# IT: Rinomina questo file in secrets.yaml e inserisci le tue chiavi reali.
# EN: Rename this file to secrets.yaml and fill in your real keys.
# IT: secrets.yaml è in .gitignore e non verrà mai versionato.
# EN: secrets.yaml is gitignored and will never be committed.
#
# IT: Sezione macro — credenziali per fonti dati macroeconomici (FRED).
# EN: Macro section — credentials for macroeconomic data sources (FRED).
# IT: FRED API key gratuita: https://fred.stlouisfed.org/docs/api/api_key.html
# EN: Free FRED API key: https://fred.stlouisfed.org/docs/api/api_key.html
macro:
  fred_api_key: "inserisci_qui_la_tua_chiave_fred"  # IT: chiave personale FRED | EN: personal FRED key
